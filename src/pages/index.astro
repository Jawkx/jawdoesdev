---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const site = {
  name: 'Jaw',
  title: 'Software engineer @coingecko',
  github: 'https://github.com/Jawkx'
};

const projects = (await getCollection('project', ({ slug }) => slug !== 'project-template')).sort(
  (a, b) =>
    (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
    a.data.title.localeCompare(b.data.title)
);

const posts = (await getCollection('post', ({ slug }) => slug !== 'template')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: '2-digit'
  }).format(date);

---

<BaseLayout title={`${site.name} | Blog`}>
  <main class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-4 py-10 sm:px-6 lg:px-8">
    <section class="flex flex-col gap-3">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{site.name}</h1>
      <p class="text-sm tracking-[0.2em] text-white/60">
        Software engineer{' '}
        <a
          href="https://www.coingecko.com/en/mobile"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-white/60 transition hover:text-white hover:decoration-white"
        >
          @CoinGecko
        </a>
      </p>
      <div class="flex flex-wrap items-center gap-4 text-sm text-white/70">
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-white/60 transition hover:text-white hover:decoration-white"
        >
          Github
        </a>
        <a
          href="https://tokscale.ai/u/Jawkx"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4 decoration-white/60 transition hover:text-white hover:decoration-white"
        >
          Tokscale
        </a>
      </div>
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="text-sm uppercase tracking-[0.3em] text-white/50">
        Projects
      </h2>
      <div class="flex flex-col gap-5">
        {projects.length === 0 ? (
          <p class="text-sm text-white/50">No projects yet. Check back soon!</p>
        ) : (
          projects.map((project) => (
            <div class="relative -mx-3 grid gap-2 px-3 py-2 hover:bg-white/[0.04] sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-8">
              <a
                class="absolute inset-0 z-10"
                href={project.data.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open ${project.data.title}`}
              ></a>
              <div class="pointer-events-none relative z-20 flex flex-col gap-1.5">
                <h3 class="text-base font-semibold text-white">
                  {project.data.title}
                </h3>
                <p class="max-w-2xl text-sm leading-relaxed text-white/55">
                  {project.data.context.split(/(https?:\/\/[^\s]+)/g).map((part) =>
                    part.startsWith('http') ? (
                      <a
                        class="pointer-events-auto underline decoration-white/40 underline-offset-4 hover:text-white hover:decoration-white"
                        href={part}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {part}
                      </a>
                    ) : part
                  )}
                </p>
              </div>
              {project.data.statusReason ? (
                <div
                  class="group/status relative z-30 flex w-fit cursor-default select-none items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-white/40 outline-none hover:text-white focus:text-white sm:justify-self-end sm:pt-1"
                  tabindex="0"
                  aria-describedby={`status-${project.slug}`}
                >
                  <span class="text-[7px] text-white/30" aria-hidden="true">●</span>
                  {project.data.status}
                  <div
                    id={`status-${project.slug}`}
                    role="tooltip"
                    class="absolute left-0 top-full hidden w-64 max-w-[calc(100vw-2rem)] pt-2 group-hover/status:block group-focus/status:block sm:left-auto sm:right-0"
                  >
                    <p class="bg-[#171717] p-3 text-left text-xs normal-case leading-relaxed tracking-normal text-white/65 shadow-xl ring-1 ring-white/10">
                      {project.data.statusReason}
                    </p>
                  </div>
                </div>
              ) : (
                <p class="pointer-events-none relative z-20 flex items-center gap-2 text-[10px] uppercase tracking-[0.18em] text-white/40 sm:pt-1">
                  <span class="text-[7px] text-white/30" aria-hidden="true">●</span>
                  {project.data.status}
                </p>
              )}
            </div>
          ))
        )}
      </div>
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="posts-heading">
      <div class="flex items-center justify-between">
        <h2 id="posts-heading" class="text-sm uppercase tracking-[0.3em] text-white/50">Posts</h2>
      </div>
      <div class="flex flex-col gap-1">
        {posts.length === 0 ? (
          <p class="text-sm text-white/50">No posts yet. Check back soon!</p>
        ) : (
          posts.map((post) => (
            <a
              class="-mx-3 grid gap-1 px-3 py-2 no-underline transition hover:bg-white/[0.04] sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-8"
              href={`/post/${post.slug}`}
            >
              <h3 class="text-base font-semibold text-white">{post.data.title}</h3>
              <time class="text-xs text-white/40" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
            </a>
          ))
        )}
      </div>
    </section>

  </main>
</BaseLayout>
