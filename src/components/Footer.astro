---
const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-white/10 py-8">
  <div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-4 sm:flex-row sm:px-6 lg:px-8">
    <p class="text-sm text-white/50">
      © {currentYear} Jaw. All rights reserved.
    </p>
    <div class="flex items-center gap-6 text-sm">
      <a
        href="https://github.com/Jawkx"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/50 transition hover:text-white"
      >
        GitHub
      </a>
      <a
        href="mailto:jaw@example.com"
        class="text-white/50 transition hover:text-white"
      >
        Contact
      </a>
    </div>
  </div>
</footer>
