---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntryBySlug } from 'astro:content';

const aboutEntry = await getEntryBySlug('about', 'me');
const AboutContent = aboutEntry ? (await aboutEntry.render()).Content : null;
---

<BaseLayout title="About | Jaw">
  <main class="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-10 sm:px-6 lg:px-8">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-white/60 underline underline-offset-4 decoration-white/60 transition hover:text-white hover:decoration-white"
    >
      ← Back
    </a>

    <header class="flex flex-col gap-3">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">About</h1>
      <p class="text-sm text-white/60">Notes, background, and anything else I add later.</p>
    </header>

    {AboutContent ? (
      <article class="space-y-5 text-sm leading-relaxed text-white/75 [&_a]:text-white [&_a]:underline">
        <AboutContent />
      </article>
    ) : (
      <p class="text-sm text-white/60">No about content yet.</p>
    )}
  </main>
</BaseLayout>
